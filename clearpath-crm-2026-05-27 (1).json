<!DOCTYPE html>
<html>
<head>
  <title>CRM App</title>
  <style>
    body { font-family: Arial; padding: 20px; }
    .card { border: 1px solid #ccc; padding: 10px; margin: 10px 0; }
  </style>
</head>
<body>

<h1>CRM Dashboard</h1>
<div id="output"></div>

<script>
fetch("data.json")
  .then(res => res.json())
  .then(data => {
    let html = "<h2>Leads</h2>";

    data.leads.forEach(lead => {
      html += `
        <div class="card">
          <b>${lead.name}</b><br>
          Status: ${lead.status}<br>
          Price: $${lead.price}<br>
          Address: ${lead.address}
        </div>
      `;
    });

    html += `
      <h2>Session</h2>
      Doors: ${data.session.doors}<br>
      Quotes: ${data.session.quotes}<br>
      Closed: ${data.session.closed}
    `;

    document.getElementById("output").innerHTML = html;
  });
</script>

</body>
</html>
